{
  "mcp": {
    "servers": {
      "sihankor": {
        "type": "http",
        "url": "http://localhost:9741/mcp",
        "enabled": false,
        "timeoutMs": 30000
      }
    }
  },
  "hooks": {
    "enabled": true,
    "events": {
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "python3 \"${ZCODE_PROJECT_DIR}/sih-tools/attnanchor/anchor.py\"",
              "timeout": 25
            }
          ]
        }
      ]
    }
  }
}
